{
  "name": "dsh-layout-control",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web overlay: hide chrome, dock the composer, filter transcript kinds, and drive sidebar/details occupancy",
  "author": "LzqSuShi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LzqSuShi/dsh-layout-control.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "layout",
    "web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT"
}
